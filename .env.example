PORT=8787
ADMIN_PASSWORD=admin123456

# Forge 生图模型背后使用 Agnes
AGNES_API_KEY=

# GPT Image 2 / OpenAI-compatible image backend
IMAGE_API_BASE_URL=https://sub.vcnovb.cn/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
GPT_IMAGE_1K_API_BASE_URL=
GPT_IMAGE_1K_API_KEY=
GPT_IMAGE_1K_MODEL=
GPT_IMAGE_1K_RESPONSE_FORMAT=
GPT_IMAGE_4K_API_BASE_URL=
GPT_IMAGE_4K_API_KEY=
GPT_IMAGE_4K_MODEL=
GPT_IMAGE_4K_RESPONSE_FORMAT=

# GPT Image fallback backend. Primary image backend is still used first.
# The generic fallback applies to 1K/2K/4K unless a tier-specific fallback is set.
GPT_IMAGE_FALLBACK_API_BASE_URL=
GPT_IMAGE_FALLBACK_API_KEY=
GPT_IMAGE_FALLBACK_MODEL=gpt-image-2
GPT_IMAGE_1K_FALLBACK_API_BASE_URL=
GPT_IMAGE_1K_FALLBACK_API_KEY=
GPT_IMAGE_1K_FALLBACK_MODEL=
GPT_IMAGE_1K_FALLBACK_RESPONSE_FORMAT=
GPT_IMAGE_2K_FALLBACK_API_BASE_URL=
GPT_IMAGE_2K_FALLBACK_API_KEY=
GPT_IMAGE_2K_FALLBACK_MODEL=
GPT_IMAGE_2K_FALLBACK_RESPONSE_FORMAT=
GPT_IMAGE_4K_FALLBACK_API_BASE_URL=
GPT_IMAGE_4K_FALLBACK_API_KEY=
GPT_IMAGE_4K_FALLBACK_MODEL=
GPT_IMAGE_4K_FALLBACK_RESPONSE_FORMAT=

# 🍌 Nannabanan / Gemini native image backend
NANNABANAN_API_BASE_URL=https://sub.g-aisc.com/v1beta
NANNABANAN_API_KEY=
NANNABANAN_MODEL=gemini-2.5-flash-image-preview
NANNABANAN_CREDIT_COST=2
NANNABANAN_TIMEOUT_MS=600000

# Reference image understanding.
# Use openai-compatible for GPT-style vision models, or aliyun for DashScope.
VISION_PROVIDER=openai-compatible
VISION_API_BASE_URL=https://sub.vcnovb.cn/v1
VISION_API_KEY=
VISION_MODEL=gpt-5.5
VISION_TIMEOUT_MS=60000

# Fallback reference-image understanding. If empty, AGNES_API_KEY can be reused.
VISION_FALLBACK_PROVIDER=agnes
VISION_FALLBACK_API_BASE_URL=https://apihub.agnes-ai.com/v1
VISION_FALLBACK_API_KEY=
VISION_FALLBACK_MODEL=agnes-2.5-flash
VISION_FALLBACK_TIMEOUT_MS=60000

# Optional Aliyun/DashScope fallback configuration.
ALIYUN_DASHSCOPE_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_DASHSCOPE_API_KEY=
ALIYUN_VISION_MODEL=qwen-vl-plus

# Optional legacy OpenAI-compatible vision aliases.
GPT_VISION_MODEL=gpt-4o-mini
